# Example Nginx reverse proxy for self-hosting (Docker / VPS).
# Reference only — not used by Vercel. Security headers come from the app,
# so they are not repeated here. With this proxy in front, set
# CLIENT_IP_HEADER=x-real-ip in the app environment.

# Per-IP request budgets
limit_req_zone $binary_remote_addr zone=site:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=contact:10m rate=6r/m;
limit_conn_zone $binary_remote_addr zone=perip:10m;

upstream afaq_app {
    server 127.0.0.1:3000;
    keepalive 64;
}

server {
    listen 80;
    server_name afaq-team.com www.afaq-team.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name afaq-team.com www.afaq-team.com;

    ssl_certificate     /etc/letsencrypt/live/afaq-team.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/afaq-team.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    server_tokens off;
    client_max_body_size 64k;
    client_body_timeout 10s;
    client_header_timeout 10s;
    keepalive_timeout 30s;
    limit_conn perip 50;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    # brotli on;  # if ngx_brotli is installed

    # Scanner noise never reaches the app
    location ~ /\.(env|git|ht) { return 404; }
    location ~ \.php$          { return 404; }

    location = /api/contact {
        limit_req zone=contact burst=3 nodelay;
        limit_except POST { deny all; }
        proxy_pass http://afaq_app;
        include /etc/nginx/afaq_proxy.conf;
    }

    location /_next/static/ {
        proxy_pass http://afaq_app;
        include /etc/nginx/afaq_proxy.conf;
        proxy_cache_valid 200 365d;
    }

    location / {
        limit_req zone=site burst=40 nodelay;
        proxy_pass http://afaq_app;
        include /etc/nginx/afaq_proxy.conf;
    }
}

# /etc/nginx/afaq_proxy.conf
#   proxy_http_version 1.1;
#   proxy_set_header Connection "";
#   proxy_set_header Host $host;
#   proxy_set_header X-Real-IP $remote_addr;
#   proxy_set_header X-Forwarded-For $remote_addr;   # overwrite, never append
#   proxy_set_header X-Forwarded-Proto $scheme;
#   proxy_read_timeout 30s;
